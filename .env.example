# Copy to .env and fill in. The seed creates the admin user from these values.
DATABASE_URL="file:./prisma/dev.db"
ADMIN_EMAIL="admin@example.com"
# At least 12 characters. Change it before using real data.
ADMIN_PASSWORD="change-me-to-a-long-password"
# Public base URL, used for sitemap, robots and canonical links.
SITE_URL="http://localhost:3000"
